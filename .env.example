# Queenstown Rewards - example environment variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Only PUBLIC, client-safe values belong here (prefixed EXPO_PUBLIC_ per Expo convention).
# The Supabase service-role key must NEVER be used in this mobile app.
# These are placeholders until Phase 7 (Supabase database) wires up the real project.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
