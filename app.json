{
  "expo": {
    "name": "Queenstown Rewards",
    "slug": "queenstown-rewards-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "queenstownrewards",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.queenstownhospitality.rewards",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.queenstownhospitality.rewards",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Queenstown Rewards uses your camera to scan redemption QR codes at participating locations.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED3D16"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Queenstown Rewards uses your location to center the map and show distances to nearby locations. This is only requested when you tap \"Use My Location\"."
        }
      ],
      "expo-font",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Black",
            "ios": "./assets/images/app-icons/icon-black.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-black.png",
              "backgroundColor": "#030303"
            }
          },
          {
            "name": "Blue",
            "ios": "./assets/images/app-icons/icon-blue.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-blue.png",
              "backgroundColor": "#112442"
            }
          },
          {
            "name": "Green",
            "ios": "./assets/images/app-icons/icon-green.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-green.png",
              "backgroundColor": "#0B3024"
            }
          },
          {
            "name": "Orange",
            "ios": "./assets/images/app-icons/icon-orange.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-orange.png",
              "backgroundColor": "#D55F27"
            }
          },
          {
            "name": "Red",
            "ios": "./assets/images/app-icons/icon-red.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-red.png",
              "backgroundColor": "#761E31"
            }
          },
          {
            "name": "White",
            "ios": "./assets/images/app-icons/icon-white.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/icon-white.png",
              "backgroundColor": "#F7E6CF"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "2f0b2fae-20c9-4342-899a-645401029fb3"
      },
      "router": {}
    },
    "owner": "code-heaven-studio",
    "updates": {
      "url": "https://u.expo.dev/2f0b2fae-20c9-4342-899a-645401029fb3"
    }
  }
}
